@model IEnumerable<Libro>

@{
    ViewData["Title"] = "Libros";
    var tituloBusqueda = ViewData["TituloBusqueda"] as string ?? string.Empty;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Libros</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo libro</a>
</div>

<div class="card card-panel mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-6">
                <input type="text" name="titulo" value="@tituloBusqueda" class="form-control" placeholder="Buscar por título" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary">Buscar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card card-panel">
    <div class="table-responsive">
        <table class="table table-biblioteca table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>ISBN</th>
                    <th>Autor</th>
                    <th>Ejemplares</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var libro in Model)
                {
                    <partial name="_LibroFila" model="libro" />
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted mt-3">No hay libros para mostrar.</p>
}
