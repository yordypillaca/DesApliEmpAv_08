@model IEnumerable<Socio>

@{
    ViewData["Title"] = "Socios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Socios</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo socio</a>
</div>

<div class="card card-panel">
    <div class="table-responsive">
        <table class="table table-biblioteca table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>DNI</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var socio in Model)
                {
                    <tr>
                        <td>@socio.DNI</td>
                        <td>@socio.Nombre</td>
                        <td>@(socio.Email ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
